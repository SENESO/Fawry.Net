<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Fawry.Net</PackageId>
    <Version>1.0.1</Version>
    <Authors>Eslam Ashraf</Authors>
    <Description>The complete .NET SDK for Fawry payments — charge (Pay-at-Fawry, cards, mobile wallets), authorize/capture, and callback verification.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SENESO/Fawry.Net</RepositoryUrl>
    <PackageTags>fawry;payments;egypt;gateway;sdk</PackageTags>
      <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SENESO/Fawry.Net</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>NuGet polish release: branded package icon, embedded README, and full repository metadata.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>


  <ItemGroup>
    <None Include="../../docs/icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
